# Copy this file to .env and fill in your own keys. .env is gitignored.
#
# Gemini API key — ONLY needed for the optional AI peer-matching feature.
# The tool runs fully without it (AI toggle off); screening, comps, WACC/DCF
# and precedent transactions all work on free Yahoo Finance data without any key.
# Get one at: https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key-here
